{
  // Repo-specific only. Personal editor preferences live in User settings
  // (synced via Settings Sync), not here - this file is public. The one
  // deliberate exception is the "No automatic edits" block at the bottom,
  // pinned here so nothing rewrites a buffer in this repo.

  // ---- Python environment ----
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",

  // The terminal profile below activates the venv itself, so the extensions'
  // own auto-activation is turned off to avoid activating twice.
  "python.terminal.activateEnvironment": false,
  "python-envs.terminal.autoActivationType": "off",

  "terminal.integrated.profiles.windows": {
    "PowerShell (.venv)": {
      "source": "PowerShell",
      "args": [
        "-NoExit",
        "-NoLogo",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        ". '${workspaceFolder}\\.venv\\Scripts\\Activate.ps1'"
      ],
      "icon": "snake"
    }
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell (.venv)",

  // ---- Python indentation ----
  // Needed because a global editor.tabSize of 2 (a JS convention) would
  // otherwise apply here, and in Python indentation is syntax.
  //
  // formatOnType is repeated here because User settings set it under
  // "[python]", and a language-specific User setting outranks a plain
  // Workspace one - the global switch below would not reach it.
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnType": false
  },

  // Same reason: User settings set quickSuggestions under "[markdown]",
  // which would outrank the workspace-wide switch further down. This repo
  // is half prose (README, Roadmap/), so it matters here.
  "[markdown]": {
    "editor.quickSuggestions": {
      "comments": "off",
      "other": "off",
      "strings": "off"
    }
  },

  // ---- Keep the virtualenv out of search and the file watcher ----
  "search.exclude": {
    "**/.venv": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true
  },

  // ---- No automatic edits ----
  // Nothing below is a style choice; the point is that the editor never
  // changes a buffer on its own. Formatting and fixes are still one
  // keystroke away (Shift+Alt+F, or the lightbulb) - just never implicit.
  // Every entry here overrides a User setting that turns the behaviour on.

  // On save / paste / type.
  "editor.formatOnSave": false,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.codeActionsOnSave": {},
  "files.trimTrailingWhitespace": false,
  "files.insertFinalNewline": false,
  "files.trimFinalNewlines": false,

  // Same, for the .ipynb files under NoteBook/ and test/.
  "notebook.formatOnSave.enabled": false,
  "notebook.formatOnCellExecution": false,
  "notebook.codeActionsOnSave": {},

  // Characters inserted or deleted that you did not type.
  "editor.autoClosingBrackets": "never",
  "editor.autoClosingQuotes": "never",
  "editor.autoClosingComments": "never",
  "editor.autoClosingDelete": "never",
  "editor.autoClosingOvertype": "never",
  "editor.autoSurround": "never",
  "editor.linkedEditing": false,
  "auto-rename-tag.activationOnLanguage": [],

  // "keep" carries the previous line's indentation onto a new line but never
  // re-indents a line you already wrote. "none" would start every line at
  // column 0, which is unusable in Python - say the word if you want that.
  "editor.autoIndent": "keep",
  "editor.trimAutoWhitespace": false,
  "editor.detectIndentation": false,

  // Suggestions still appear; accepting one is now always deliberate.
  // Enter always means newline, Tab always means indent.
  "editor.acceptSuggestionOnEnter": "off",
  "editor.tabCompletion": "off",

  // Imports and call signatures stay exactly as written.
  "javascript.updateImportsOnFileMove.enabled": "never",
  "typescript.updateImportsOnFileMove.enabled": "never",
  "javascript.suggest.completeFunctionCalls": false,
  "typescript.suggest.completeFunctionCalls": false,
  "python.analysis.autoImportCompletions": false,

  // ---- No Quick Fix / lightbulb offers ----
  // The bulb in the gutter and the "Change spelling to..." menu it opens.
  // Ctrl+. still summons it on demand; it just stops offering itself.
  "editor.lightbulb.enabled": "off",
  "editor.codeActionWidget.includeNearbyQuickFixes": false,

  // Drops the "Fix", "Explain" and "Implement all inherited abstract
  // classes" entries Copilot injects into that same menu.
  "github.copilot.editor.enableCodeActions": false,
  "github.copilot.nextEditSuggestions.enabled": false,

  // ---- No suggestions of any kind ----
  // Inline ghost text and the Accept/Accept Word toolbar that rides on it.
  // inlineSuggest is the provider-agnostic switch; the copilot ones stop it
  // at the source. User settings turn all three on.
  "editor.inlineSuggest.enabled": false,
  "editor.inlineSuggest.showToolbar": "never",
  "github.copilot.editor.enableAutoCompletions": false,
  "github.copilot.enable": {
    "*": false
  },

  // The IntelliSense popup, and the ghost-text preview of whatever row is
  // selected in it. Ctrl+Space still opens it deliberately.
  "editor.quickSuggestions": {
    "comments": "off",
    "other": "off",
    "strings": "off"
  },
  "editor.suggestOnTriggerCharacters": false,
  "editor.wordBasedSuggestions": "off",
  "editor.snippetSuggestions": "none",
  "editor.suggest.preview": false,
  "editor.parameterHints.enabled": false
}
